<?xml version="1.0" encoding="UTF-8"?>
<site-conf xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="http://ofbiz.apache.org/dtds/site-conf.xsd">

    <include location="component://common/webapp/common/WEB-INF/common-controller.xml"/>

    <description>Customer Management Controller</description>
    <owner>OFBiz Plugin</owner>

    <!-- ═══════════════════ REQUEST MAPPINGS ════════════════════ -->

    <request-map uri="main">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="main"/>
    </request-map>

    <!-- Step 7: event that triggers findCustomer (GET search) -->
    <request-map uri="FindCustomer">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="FindCustomer"/>
    </request-map>

    <!-- Step 7: event that triggers createCustomer service -->
    <request-map uri="createCustomer">
        <security https="true" auth="true"/>
        <event type="service" invoke="createCustomer"/>
        <response name="success" type="view" value="FindCustomer"/>
        <response name="error"   type="view" value="FindCustomer"/>
    </request-map>

    <!-- Step 7: event that triggers updateCustomer service -->
    <request-map uri="updateCustomer">
        <security https="true" auth="true"/>
        <event type="service" invoke="updateCustomer"/>
        <response name="success" type="view" value="FindCustomer"/>
        <response name="error"   type="view" value="FindCustomer"/>
    </request-map>

    <!-- Step 6a event mapping -->
    <request-map uri="createCustomerRelationship">
        <security https="true" auth="true"/>
        <event type="service" invoke="createCustomerRelationship"/>
        <response name="success" type="view" value="FindCustomer"/>
        <response name="error"   type="view" value="FindCustomer"/>
    </request-map>

    <!-- Step 6b event mapping -->
    <request-map uri="updateCustomerRelationship">
        <security https="true" auth="true"/>
        <event type="service" invoke="updateCustomerRelationship"/>
        <response name="success" type="view" value="FindCustomer"/>
        <response name="error"   type="view" value="FindCustomer"/>
    </request-map>

    <!-- ═══════════════════ VIEW MAPPINGS ═══════════════════════ -->

    <view-map name="main"
        type="screen"
        page="component://CustomerManagement/widget/CustomerManagementScreens.xml#main"/>

    <view-map name="FindCustomer"
        type="screen"
        page="component://CustomerManagement/widget/CustomerManagementScreens.xml#FindCustomer"/>

</site-conf>
