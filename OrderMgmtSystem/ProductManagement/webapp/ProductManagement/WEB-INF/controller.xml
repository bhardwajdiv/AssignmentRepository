<?xml version="1.0" encoding="UTF-8"?>
<site-conf xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="http://ofbiz.apache.org/dtds/site-conf.xsd">

    <include location="component://common/webapp/common/WEB-INF/common-controller.xml"/>

    <description>Product Management Controller</description>
    <owner>OFBiz Plugin</owner>

    <!-- ═══════════════════════ REQUEST MAPPINGS ═══════════════════════ -->

    <request-map uri="main">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="main"/>
    </request-map>

    <!-- Step 7: event that triggers findProduct (GET search) -->
    <request-map uri="FindProduct">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="FindProduct"/>
    </request-map>

    <!-- Step 7: event that triggers createProduct service -->
    <request-map uri="createProduct">
        <security https="true" auth="true"/>
        <event type="service" invoke="createProduct"/>
        <response name="success" type="view" value="FindProduct"/>
        <response name="error"   type="view" value="FindProduct"/>
    </request-map>

    <!-- Step 7: event that triggers updateProduct service -->
    <request-map uri="updateProduct">
        <security https="true" auth="true"/>
        <event type="service" invoke="updateProduct"/>
        <response name="success" type="view" value="FindProduct"/>
        <response name="error"   type="view" value="FindProduct"/>
    </request-map>

    <!-- Step 6a event mapping -->
    <request-map uri="assocProductToVirtual">
        <security https="true" auth="true"/>
        <event type="service" invoke="assocProductToVirtual"/>
        <response name="success" type="view" value="FindProduct"/>
        <response name="error"   type="view" value="FindProduct"/>
    </request-map>

    <!-- Step 6b event mapping -->
    <request-map uri="updateProductVariant">
        <security https="true" auth="true"/>
        <event type="service" invoke="updateProductVariant"/>
        <response name="success" type="view" value="FindProduct"/>
        <response name="error"   type="view" value="FindProduct"/>
    </request-map>

    <!-- ═══════════════════════ VIEW MAPPINGS ════════════════════════════ -->

    <view-map name="main"
        type="screen"
        page="component://ProductManagement/widget/ProductManagementScreens.xml#main"/>

    <view-map name="FindProduct"
        type="screen"
        page="component://ProductManagement/widget/ProductManagementScreens.xml#FindProduct"/>

</site-conf>
