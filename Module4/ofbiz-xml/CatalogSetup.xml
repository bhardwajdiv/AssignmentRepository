<?xml version="1.0" encoding="UTF-8"?>
<entity-engine-xml>

    <!-- Part 3: Activity 1 - Shoes Catalog -->
    <ProdCatalog prodCatalogId="SHOES_CATALOG" catalogName="Shoes Catalog"/>
    <ProductStoreCatalog productStoreId="STORE" prodCatalogId="SHOES_CATALOG" fromDate="2026-01-01 00:00:00.000" sequenceNum="1"/>

    <!-- Define Categories -->
    <ProductCategory productCategoryId="SHOES_ROOT" productCategoryTypeId="CATALOG_CATEGORY" description="Browse Root"/>
    <ProductCategory productCategoryId="SHOES_MEN" productCategoryTypeId="CATALOG_CATEGORY" description="Men"/>
    <ProductCategory productCategoryId="SHOES_WOMEN" productCategoryTypeId="CATALOG_CATEGORY" description="Women"/>
    <ProductCategory productCategoryId="SHOES_CHILDREN" productCategoryTypeId="CATALOG_CATEGORY" description="Children"/>
    <ProductCategory productCategoryId="SHOES_PROMOTION" productCategoryTypeId="CATALOG_CATEGORY" description="Promotion"/>

    <!-- Men Subcategories -->
    <ProductCategory productCategoryId="SHOES_MSPORTS" productCategoryTypeId="CATALOG_CATEGORY" description="MSports"/>
    <ProductCategory productCategoryId="SHOES_MFORMAL" productCategoryTypeId="CATALOG_CATEGORY" description="MFormal"/>
