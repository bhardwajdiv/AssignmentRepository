    <ProductCategoryRollup parentProductCategoryId="SHOES_WOMEN" productCategoryId="SHOES_WFORMAL" fromDate="2026-01-01 00:00:00.000"/>
    <ProductCategoryRollup parentProductCategoryId="SHOES_WOMEN" productCategoryId="SHOES_WPARTY" fromDate="2026-01-01 00:00:00.000"/>

    <!-- Part 3: Activity 2 - Define Features -->
    <ProductFeatureType productFeatureTypeId="COLOR" description="Color"/>
    <ProductFeatureType productFeatureTypeId="SIZE" description="Size"/>

    <!-- Color Features -->
    <ProductFeature productFeatureId="COLOR_RED" productFeatureTypeId="COLOR" description="Red"/>
    <ProductFeature productFeatureId="COLOR_BLACK" productFeatureTypeId="COLOR" description="Black"/>
    <ProductFeature productFeatureId="COLOR_WHITE" productFeatureTypeId="COLOR" description="White"/>
    <ProductFeature productFeatureId="COLOR_BROWN" productFeatureTypeId="COLOR" description="Brown"/>

    <!-- Size Features -->
    <ProductFeature productFeatureId="SIZE_2" productFeatureTypeId="SIZE" description="2"/>
    <ProductFeature productFeatureId="SIZE_3" productFeatureTypeId="SIZE" description="3"/>
    <ProductFeature productFeatureId="SIZE_4" productFeatureTypeId="SIZE" description="4"/>
    <ProductFeature productFeatureId="SIZE_5" productFeatureTypeId="SIZE" description="5"/>
    <ProductFeature productFeatureId="SIZE_7" productFeatureTypeId="SIZE" description="7"/>
    <ProductFeature productFeatureId="SIZE_8" productFeatureTypeId="SIZE" description="8"/>
    <ProductFeature productFeatureId="SIZE_9" productFeatureTypeId="SIZE" description="9"/>
    <ProductFeature productFeatureId="SIZE_10" productFeatureTypeId="SIZE" description="10"/>
    <ProductFeature productFeatureId="SIZE_11" productFeatureTypeId="SIZE" description="11"/>


    <!-- Define Products (Virtual) -->
    <!-- Men > MSports -->
    <Product productId="MS-1" productTypeId="FINISHED_GOOD" isVirtual="Y" isVariant="N" internalName="Men Sports Shoe 1"/>
    <ProductCategoryMember productId="MS-1" productCategoryId="SHOES_MSPORTS" fromDate="2026-01-01 00:00:00.000"/>
    <ProductCategoryMember productId="MS-1" productCategoryId="SHOES_PROMOTION" fromDate="2026-01-01 00:00:00.000"/>

    <Product productId="MS-2" productTypeId="FINISHED_GOOD" isVirtual="Y" isVariant="N" internalName="Men Sports Shoe 2"/>
    <ProductCategoryMember productId="MS-2" productCategoryId="SHOES_MSPORTS" fromDate="2026-01-01 00:00:00.000"/>

    <!-- Men > MFormal -->
    <Product productId="MF-1" productTypeId="FINISHED_GOOD" isVirtual="Y" isVariant="N" internalName="Men Formal Shoe 1"/>
    <ProductCategoryMember productId="MF-1" productCategoryId="SHOES_MFORMAL" fromDate="2026-01-01 00:00:00.000"/>

    <Product productId="MF-2" productTypeId="FINISHED_GOOD" isVirtual="Y" isVariant="N" internalName="Men Formal Shoe 2"/>
    <ProductCategoryMember productId="MF-2" productCategoryId="SHOES_MFORMAL" fromDate="2026-01-01 00:00:00.000"/>
    <ProductCategoryMember productId="MF-2" productCategoryId="SHOES_PROMOTION" fromDate="2026-01-01 00:00:00.000"/>

    <!-- Men > MParty -->
    <Product productId="MP-1" productTypeId="FINISHED_GOOD" isVirtual="Y" isVariant="N" internalName="Men Party Shoe 1"/>
    <ProductCategoryMember productId="MP-1" productCategoryId="SHOES_MPARTY" fromDate="2026-01-01 00:00:00.000"/>
    <ProductCategoryMember productId="MP-1" productCategoryId="SHOES_PROMOTION" fromDate="2026-01-01 00:00:00.000"/>

    <Product productId="MP-2" productTypeId="FINISHED_GOOD" isVirtual="Y" isVariant="N" internalName="Men Party Shoe 2"/>
    <ProductCategoryMember productId="MP-2" productCategoryId="SHOES_MPARTY" fromDate="2026-01-01 00:00:00.000"/>

    <!-- Women > WSports -->
    <Product productId="WS-1" productTypeId="FINISHED_GOOD" isVirtual="Y" isVariant="N" internalName="Women Sports Shoe 1"/>
    <ProductCategoryMember productId="WS-1" productCategoryId="SHOES_WSPORTS" fromDate="2026-01-01 00:00:00.000"/>
    <ProductCategoryMember productId="WS-1" productCategoryId="SHOES_PROMOTION" fromDate="2026-01-01 00:00:00.000"/>

    <Product productId="WS-2" productTypeId="FINISHED_GOOD" isVirtual="Y" isVariant="N" internalName="Women Sports Shoe 2"/>
    <ProductCategoryMember productId="WS-2" productCategoryId="SHOES_WSPORTS" fromDate="2026-01-01 00:00:00.000"/>

    <!-- Women > WFormal -->
    <Product productId="WF-1" productTypeId="FINISHED_GOOD" isVirtual="Y" isVariant="N" internalName="Women Formal Shoe 1"/>
    <ProductCategoryMember productId="WF-1" productCategoryId="SHOES_WFORMAL" fromDate="2026-01-01 00:00:00.000"/>
    <ProductCategoryMember productId="WF-1" productCategoryId="SHOES_PROMOTION" fromDate="2026-01-01 00:00:00.000"/>

    <Product productId="WF-2" productTypeId="FINISHED_GOOD" isVirtual="Y" isVariant="N" internalName="Women Formal Shoe 2"/>
    <ProductCategoryMember productId="WF-2" productCategoryId="SHOES_WFORMAL" fromDate="2026-01-01 00:00:00.000"/>

    <!-- Women > WParty -->
