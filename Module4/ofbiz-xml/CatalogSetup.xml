    <ProductCategoryMember productId="WP-1" productCategoryId="SHOES_WPARTY" fromDate="2026-01-01 00:00:00.000"/>
    <ProductCategoryMember productId="WP-1" productCategoryId="SHOES_PROMOTION" fromDate="2026-01-01 00:00:00.000"/>

    <Product productId="WP-2" productTypeId="FINISHED_GOOD" isVirtual="Y" isVariant="N" internalName="Women Party Shoe 2"/>
    <ProductCategoryMember productId="WP-2" productCategoryId="SHOES_WPARTY" fromDate="2026-01-01 00:00:00.000"/>

    <!-- Children -->
    <Product productId="C-1" productTypeId="FINISHED_GOOD" isVirtual="Y" isVariant="N" internalName="Children Shoe 1"/>
    <ProductCategoryMember productId="C-1" productCategoryId="SHOES_CHILDREN" fromDate="2026-01-01 00:00:00.000"/>
    <ProductCategoryMember productId="C-1" productCategoryId="SHOES_PROMOTION" fromDate="2026-01-01 00:00:00.000"/>

    <Product productId="C-2" productTypeId="FINISHED_GOOD" isVirtual="Y" isVariant="N" internalName="Children Shoe 2"/>
    <ProductCategoryMember productId="C-2" productCategoryId="SHOES_CHILDREN" fromDate="2026-01-01 00:00:00.000"/>
    <ProductCategoryMember productId="C-2" productCategoryId="SHOES_PROMOTION" fromDate="2026-01-01 00:00:00.000"/>


    <!-- Define Product Variant Records (For Shoes used in Orders & Promotion) -->
    <!-- MS-1 Variants -->
    <Product productId="MS-1-W-7" productTypeId="FINISHED_GOOD" isVirtual="N" isVariant="Y" internalName="Men Sports Shoe 1 - White - 7"/>
    <ProductAssoc productId="MS-1" productIdTo="MS-1-W-7" productAssocTypeId="PRODUCT_VARIANT" fromDate="2026-01-01 00:00:00.000"/>
    <ProductFeatureAppl productId="MS-1-W-7" productFeatureId="COLOR_WHITE" productFeatureApplTypeId="STANDARD_FEATURE" fromDate="2026-01-01 00:00:00.000"/>
    <ProductFeatureAppl productId="MS-1-W-7" productFeatureId="SIZE_7" productFeatureApplTypeId="STANDARD_FEATURE" fromDate="2026-01-01 00:00:00.000"/>

    <Product productId="MS-1-W-8" productTypeId="FINISHED_GOOD" isVirtual="N" isVariant="Y" internalName="Men Sports Shoe 1 - White - 8"/>
    <ProductAssoc productId="MS-1" productIdTo="MS-1-W-8" productAssocTypeId="PRODUCT_VARIANT" fromDate="2026-01-01 00:00:00.000"/>
    <ProductFeatureAppl productId="MS-1-W-8" productFeatureId="COLOR_WHITE" productFeatureApplTypeId="STANDARD_FEATURE" fromDate="2026-01-01 00:00:00.000"/>
    <ProductFeatureAppl productId="MS-1-W-8" productFeatureId="SIZE_8" productFeatureApplTypeId="STANDARD_FEATURE" fromDate="2026-01-01 00:00:00.000"/>

    <!-- MF-2 Variants -->
    <Product productId="MF-2-W-7" productTypeId="FINISHED_GOOD" isVirtual="N" isVariant="Y" internalName="Men Formal Shoe 2 - White - 7"/>
    <ProductAssoc productId="MF-2" productIdTo="MF-2-W-7" productAssocTypeId="PRODUCT_VARIANT" fromDate="2026-01-01 00:00:00.000"/>
    <ProductFeatureAppl productId="MF-2-W-7" productFeatureId="COLOR_WHITE" productFeatureApplTypeId="STANDARD_FEATURE" fromDate="2026-01-01 00:00:00.000"/>
