    <ProductCategory productCategoryId="SHOES_WFORMAL" productCategoryTypeId="CATALOG_CATEGORY" description="WFormal"/>
    <ProductCategory productCategoryId="SHOES_WPARTY" productCategoryTypeId="CATALOG_CATEGORY" description="WParty"/>

    <!-- Catalog-Category Association -->
    <ProdCatalogCategory prodCatalogId="SHOES_CATALOG" productCategoryId="SHOES_ROOT" prodCatalogCategoryTypeId="PCCT_BROWSE_ROOT" fromDate="2026-01-01 00:00:00.000"/>

    <!-- Category Rollups -->
    <ProductCategoryRollup parentProductCategoryId="SHOES_ROOT" productCategoryId="SHOES_MEN" fromDate="2026-01-01 00:00:00.000"/>
    <ProductCategoryRollup parentProductCategoryId="SHOES_ROOT" productCategoryId="SHOES_WOMEN" fromDate="2026-01-01 00:00:00.000"/>
    <ProductCategoryRollup parentProductCategoryId="SHOES_ROOT" productCategoryId="SHOES_CHILDREN" fromDate="2026-01-01 00:00:00.000"/>
    <ProductCategoryRollup parentProductCategoryId="SHOES_ROOT" productCategoryId="SHOES_PROMOTION" fromDate="2026-01-01 00:00:00.000"/>

    <ProductCategoryRollup parentProductCategoryId="SHOES_MEN" productCategoryId="SHOES_MSPORTS" fromDate="2026-01-01 00:00:00.000"/>
    <ProductCategoryRollup parentProductCategoryId="SHOES_MEN" productCategoryId="SHOES_MFORMAL" fromDate="2026-01-01 00:00:00.000"/>
