    <ProductFeatureAppl productId="MP-1-W-7" productFeatureId="SIZE_7" productFeatureApplTypeId="STANDARD_FEATURE" fromDate="2026-01-01 00:00:00.000"/>


    <!-- Part 3: Activity 3 - Create Promotion -->
    <ProductPromo productPromoId="SHOES_PROMO" promoName="Shoes Promotion" promoText="Get 10% discount on white and brown shoes in promotion list" userEntered="Y"/>
    <ProductPromoStore productStoreId="STORE" productPromoId="SHOES_PROMO" fromDate="2026-01-01 00:00:00.000"/>
    <ProductPromoRule productPromoId="SHOES_PROMO" productPromoRuleId="01" ruleName="Category Discount"/>
    
    <!-- Promotion Condition: Order must include items from the SHOES_PROMOTION category -->
    <ProductPromoCond productPromoId="SHOES_PROMO" productPromoRuleId="01" productPromoCondSeqId="01" inputParamEnumId="PPIP_PRODUCT_TOTAL" operatorEnumId="PPC_GTE" condValue="0.00"/>
    <ProductPromoCategoryOrProduct productPromoId="SHOES_PROMO" productPromoRuleId="01" productPromoActionSeqId="_NA_" productPromoCondSeqId="01" productCategoryId="SHOES_PROMOTION" promoTypeEnumId="PROMO_PRT_PART_EXP"/>

    <!-- Promotion Action: 10% Discount on selected category items -->
    <ProductPromoAction productPromoId="SHOES_PROMO" productPromoRuleId="01" productPromoActionSeqId="01" productPromoActionEnumId="PROMO_PROD_DISC" amount="10.0"/>
    <ProductPromoCategoryOrProduct productPromoId="SHOES_PROMO" productPromoRuleId="01" productPromoActionSeqId="01" productPromoCondSeqId="_NA_" productCategoryId="SHOES_PROMOTION" promoTypeEnumId="PROMO_PRT_PART_EXP"/>


    <!-- Part 3: Activity 6 - Facility and Inventory Item Storage -->
    <Facility facilityId="STORE_FACILITY" facilityTypeId="WAREHOUSE" facilityName="Main Store Warehouse"/>
    
    <!-- Add Inventory Items for Variant Products -->
    <InventoryItem inventoryItemId="INV_MS1_W7" inventoryItemTypeId="NON_SERIAL_INV_ITEM" productId="MS-1-W-7" facilityId="STORE_FACILITY" datetimeReceived="2026-01-01 00:00:00.000" quantityOnHandTotal="100" availableToPromiseTotal="100"/>
    <InventoryItem inventoryItemId="INV_MS1_W8" inventoryItemTypeId="NON_SERIAL_INV_ITEM" productId="MS-1-W-8" facilityId="STORE_FACILITY" datetimeReceived="2026-01-01 00:00:00.000" quantityOnHandTotal="100" availableToPromiseTotal="100"/>
    <InventoryItem inventoryItemId="INV_MF2_W7" inventoryItemTypeId="NON_SERIAL_INV_ITEM" productId="MF-2-W-7" facilityId="STORE_FACILITY" datetimeReceived="2026-01-01 00:00:00.000" quantityOnHandTotal="100" availableToPromiseTotal="100"/>
    <InventoryItem inventoryItemId="INV_MP1_W7" inventoryItemTypeId="NON_SERIAL_INV_ITEM" productId="MP-1-W-7" facilityId="STORE_FACILITY" datetimeReceived="2026-01-01 00:00:00.000" quantityOnHandTotal="100" availableToPromiseTotal="100"/>

