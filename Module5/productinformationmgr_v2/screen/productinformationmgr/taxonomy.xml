<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="anonymous-all">

    <!-- ============================================================ -->
    <!-- TRANSITIONS                                                   -->
    <!-- ============================================================ -->
    <transition name="createTopic">
        <actions>
            <service-call name="create#productinformationmgr_v2.Topic" in-map="true"/>
        </actions>
        <default-response url="."/>
    </transition>

    <transition name="createProductCategory">
        <actions>
            <service-call name="create#productinformationmgr_v2.ProductCategory" in-map="true"/>
        </actions>
        <default-response url="."/>
    </transition>

    <!-- ============================================================ -->
    <!-- ACTIONS                                                      -->
    <!-- ============================================================ -->
    <actions>
        <entity-find entity-name="productinformationmgr_v2.Topic" list="topicList">
            <search-form-inputs/>
            <order-by field-name="typeEnumId,parentId,score DESC"/>
        </entity-find>
        <entity-find entity-name="moqui.basic.Enumeration" list="topicTypeList">
            <econdition field-name="enumTypeId" value="TopicType"/>
        </entity-find>
        <entity-find entity-name="productinformationmgr_v2.Topic" list="allTopics"/>

        <entity-find entity-name="productinformationmgr_v2.ProductCategory" list="categoryList">
            <order-by field-name="sequenceNum,categoryName"/>
        </entity-find>
        <entity-find entity-name="productinformationmgr_v2.ProductCategory" list="allCategories"/>
    </actions>

    <!-- ============================================================ -->
    <!-- WIDGETS                                                      -->
    <!-- ============================================================ -->
    <widgets>

        <!-- ROW 1: Taxonomy Topics -->
        <container-row>
            <row-col md="4">
                <container-box>
                    <box-header title="Add Taxonomy Node"/>
                    <box-body>
                        <form-single name="CreateTopicForm" transition="createTopic">
                            <field name="topicId">
                                <default-field title="Node ID (e.g. T_LAPTOPS)">
                                    <text-line size="20"/>
                                </default-field>
                            </field>
                            <field name="name">
                                <default-field title="Name"><text-line size="30"/></default-field>
                            </field>
                            <field name="typeEnumId">
                                <default-field title="Type">
                                    <drop-down>
                                        <list-options list="topicTypeList" key="${enumId}" text="${description}"/>
                                    </drop-down>
                                </default-field>
                            </field>
                            <field name="parentId">
                                <default-field title="Parent Node">
                                    <drop-down allow-empty="true">
                                        <list-options list="allTopics" key="${topicId}"
                                                      text="${name} (${typeEnumId})"/>
                                    </drop-down>
                                </default-field>
                            </field>
                            <field name="score">
                                <default-field title="Popularity Score">
                                    <text-line size="6" default-value="0.0"/>
                                </default-field>
                            </field>
                            <field name="submitBtn">
                                <default-field title="Create Node"><submit/></default-field>
                            </field>
                        </form-single>
                    </box-body>
                </container-box>
            </row-col>

            <row-col md="8">
                <container-box>
                    <box-header title="Taxonomy Tree"/>
                    <box-body>
                        <form-list name="TopicList" list="topicList" skip-form="true">
                            <field name="typeEnumId">
                                <header-field show-order-by="true"/>
                                <default-field title="Level">
                                    <display-entity entity-name="moqui.basic.Enumeration"
                                                   key-field-name="enumId" text="${description}"/>
                                </default-field>
                            </field>
                            <field name="topicId">
                                <header-field show-order-by="true"/>
                                <default-field title="Node ID"><display/></default-field>
                            </field>
                            <field name="name">
                                <header-field show-order-by="true"><text-find/></header-field>
                                <default-field title="Name"><display/></default-field>
                            </field>
                            <field name="parentId">
                                <header-field show-order-by="true"/>
                                <default-field title="Parent">
                                    <display-entity entity-name="productinformationmgr_v2.Topic"
                                                   key-field-name="topicId" text="${name}"/>
                                </default-field>
                            </field>
                            <field name="score">
                                <header-field show-order-by="true"/>
                                <default-field title="Score"><display/></default-field>
                            </field>
                        </form-list>
                    </box-body>
                </container-box>
            </row-col>
        </container-row>

        <!-- ROW 2: Product Categories -->
        <container-row>
            <row-col md="4">
                <container-box>
                    <box-header title="Add Product Category"/>
                    <box-body>
                        <form-single name="CreateCategoryForm" transition="createProductCategory">
                            <field name="productCategoryId">
                                <default-field title="Category ID (e.g. CAT_MOBILE)">
                                    <text-line size="20"/>
                                </default-field>
                            </field>
                            <field name="categoryName">
                                <default-field title="Name"><text-line size="30"/></default-field>
                            </field>
                            <field name="parentCategoryId">
                                <default-field title="Parent Category">
                                    <drop-down allow-empty="true">
                                        <list-options list="allCategories"
                                                      key="${productCategoryId}"
                                                      text="${categoryName}"/>
                                    </drop-down>
                                </default-field>
                            </field>
                            <field name="sequenceNum">
                                <default-field title="Sequence #"><text-line size="5"/></default-field>
                            </field>
                            <field name="description">
                                <default-field title="Description"><text-area cols="30" rows="2"/></default-field>
                            </field>
                            <field name="submitBtn">
                                <default-field title="Create Category"><submit/></default-field>
                            </field>
                        </form-single>
                    </box-body>
                </container-box>
            </row-col>

            <row-col md="8">
                <container-box>
                    <box-header title="Product Category Hierarchy"/>
                    <box-body>
                        <form-list name="CategoryList" list="categoryList" skip-form="true">
                            <field name="productCategoryId">
                                <default-field title="Category ID"><display/></default-field>
                            </field>
                            <field name="categoryName">
                                <default-field title="Name"><display/></default-field>
                            </field>
                            <field name="parentCategoryId">
                                <default-field title="Parent">
                                    <display-entity entity-name="productinformationmgr_v2.ProductCategory"
                                                   key-field-name="productCategoryId"
                                                   text="${categoryName}"/>
                                </default-field>
                            </field>
                            <field name="sequenceNum">
                                <default-field title="Seq"><display/></default-field>
                            </field>
                        </form-list>
                    </box-body>
                </container-box>
            </row-col>
        </container-row>

    </widgets>

</screen>
