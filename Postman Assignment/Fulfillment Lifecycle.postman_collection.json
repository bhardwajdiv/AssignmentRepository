    {
      "name": "Ship",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "let groups = JSON.parse(pm.environment.get(\"shipmentGroups\"));",
              "let index = parseInt(pm.environment.get(\"groupIndex\"));",
              "",
              "index++;",
              "pm.environment.set(\"groupIndex\", index);",
              "",
              "if(index < groups.length) {",
              "    postman.setNextRequest(\"Pick Order\");",
              "} else {",
              "    console.log(\"All Fulfillment Completed\");",
              "    postman.setNextRequest(null);",
              "}",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
